FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg && rm -rf /var/lib/apt/lists/*
COPY inpainting_service/requirements.txt ./requirements.txt
RUN pip3 install --no-cache-dir -r requirements.txt
COPY inpainting_service ./inpainting_service

EXPOSE 8090
CMD ["uvicorn", "inpainting_service.app:app", "--host", "0.0.0.0", "--port", "8090"]
