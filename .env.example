# ─────────────────────────────────────────────────────────────
# Content Automation Hub — Environment Variables (example)
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# ─── App ───────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ─── Supabase (Auth + Postgres + Storage) ──────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection for migrations / worker
DATABASE_URL=postgresql://postgres:password@localhost:5432/content_hub

# ─── Redis (BullMQ queues) ─────────────────────
REDIS_URL=redis://localhost:6379

# ─── Token encryption (AES-256-GCM) ────────────
# 32-byte key, base64-encoded. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ─── Meta Graph API ────────────────────────────
META_APP_ID=
META_APP_SECRET=
# Verify token for webhook subscription handshake
META_WEBHOOK_VERIFY_TOKEN=
# App secret used to validate X-Hub-Signature-256 (usually = META_APP_SECRET)
META_WEBHOOK_APP_SECRET=

# ─── AI: text/analysis (default provider = gemini) ───
AI_PROVIDER=gemini
# Được dùng cho cả Text, Analysis, và tính năng nhận diện phụ đề (ASR) trong Remix Studio
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Optional fallbacks (adapter is provider-agnostic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── AI: image generation (ComfyUI self-host) ──
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_TIMEOUT_MS=180000

# ─── AI: image-edit agent (simple edits: remove/overlay logo) ───
IMAGE_EDIT_PROVIDER=comfyui

# ─── Cost tracking ─────────────────────────────
# USD -> VND conversion rate for AI cost reporting (R9.2)
USD_TO_VND_RATE=25400
AI_MONTHLY_BUDGET_VND=500000

# ─── Content Remix (ffmpeg pipeline) ───────────
# Bỏ trống để dùng binary static trong node_modules (ffmpeg-static/ffprobe-static)
FFMPEG_PATH=
FFPROBE_PATH=
# Logo watermark cho option "chèn logo" — URL ảnh PNG công khai
BRAND_LOGO_URL=

# ─── TTS lồng tiếng Việt (option dubVi) ────────
# none | google | say   (say = macOS, chỉ để dev, KHÔNG dùng cho nội dung thật)
TTS_PROVIDER=none
GOOGLE_TTS_API_KEY=
TTS_VOICE_VI=vi-VN-Neural2-A
TTS_SPEAKING_RATE=1.0

# ─── Playwright Unofficial Connector ───────────
# false = browser hiển thị (cần thiết cho connect flow)
# true  = headless (sau khi đã có session)
PLAYWRIGHT_HEADLESS=false
