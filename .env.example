# ─────────────────────────────────────────────────────────────
# Content Automation Hub — Environment Variables (example)
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# ─── App ───────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ─── Supabase (Auth + Postgres + Storage) ──────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection for migrations / worker
DATABASE_URL=postgresql://postgres:password@localhost:5432/content_hub

# ─── Redis (BullMQ queues) ─────────────────────
REDIS_URL=redis://localhost:6379

# ─── Token encryption (AES-256-GCM) ────────────
# 32-byte key, base64-encoded. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ─── Meta Graph API ────────────────────────────
META_APP_ID=
META_APP_SECRET=
# Verify token for webhook subscription handshake
META_WEBHOOK_VERIFY_TOKEN=
# App secret used to validate X-Hub-Signature-256 (usually = META_APP_SECRET)
META_WEBHOOK_APP_SECRET=

# ─── AI: text/analysis (default provider = gemini) ───
AI_PROVIDER=gemini
# Được dùng cho cả Text, Analysis, và tính năng nhận diện phụ đề (ASR) trong Remix Studio
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Optional fallbacks (adapter is provider-agnostic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── AI: image generation (ComfyUI self-host) ──
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_TIMEOUT_MS=180000

# ─── AI: image-edit agent (simple edits: remove/overlay logo) ───
IMAGE_EDIT_PROVIDER=comfyui

# ─── Cost tracking ─────────────────────────────
# USD -> VND conversion rate for AI cost reporting (R9.2)
USD_TO_VND_RATE=25400
AI_MONTHLY_BUDGET_VND=500000

# ─── Content Remix (ffmpeg pipeline) ───────────
# Bỏ trống để dùng binary static trong node_modules (ffmpeg-static/ffprobe-static)
FFMPEG_PATH=
FFPROBE_PATH=
# Logo watermark cho option "chèn logo" — URL ảnh PNG công khai
BRAND_LOGO_URL=
# Text-on-screen OCR engine: gemini | paddleocr
ON_SCREEN_TEXT_ENGINE=gemini
PADDLEOCR_SERVICE_URL=http://ocr:8080
PADDLEOCR_TIMEOUT_MS=120000
PADDLEOCR_LANG=en
PADDLEOCR_SAMPLE_INTERVAL_SEC=0.5
PADDLEOCR_MAX_SAMPLE_FRAMES=90
PADDLEOCR_FRAME_WIDTH_LIMIT=1920

# Translate Voice Pipeline V2 — WhisperX/Silero sidecar
VOICE_PIPELINE_URL=http://localhost:8766
VOICE_PIPELINE_TIMEOUT_MS=300000
VOICE_ALIGNMENT_PROVIDER=whisperx
# true = localization phải dùng Voice V2; nếu sidecar lỗi thì fail-fast để tránh output sai nội dung.
VOICE_REQUIRE_V2_FOR_LOCALIZATION=true
# auto = gửi audioBase64 để sidecar Docker/host đều đọc được; false = chỉ gửi audioPath
VOICE_PIPELINE_SEND_BASE64=auto
WHISPERX_MODEL=small
WHISPERX_COMPUTE_TYPE=int8
WHISPERX_BATCH_SIZE=4
VOICE_MIN_PAUSE_GAP_MS=350
VOICE_MAX_CUE_DURATION_SEC=6
VOICE_MAX_CHARS_PER_CUE=90
VOICE_TTS_STRETCH_MIN=0.85
VOICE_TTS_STRETCH_MAX=1.18
VOICE_TTS_CUE_GAP_MS=120
VOICE_SEPARATION_PROVIDER=eq

# ─── TTS lồng tiếng Việt (option dubVi) ────────
# none | google | say   (say = macOS, chỉ để dev, KHÔNG dùng cho nội dung thật)
TTS_PROVIDER=none
GOOGLE_TTS_API_KEY=
TTS_VOICE_VI=vi-VN-Neural2-A
TTS_SPEAKING_RATE=1.0

# ─── Playwright Unofficial Connector ───────────
# false = browser hiển thị (cần thiết cho connect flow)
# true  = headless (sau khi đã có session)
PLAYWRIGHT_HEADLESS=false

# ─── HeyGen Video Translate ─────────────────────
# Dùng khi dubMode='heygen' trong Remix Studio.
# Lấy API key tại: https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=
HEYGEN_API_BASE_URL=https://api.heygen.com
# Webhook callback — server cần có public URL (dùng ngrok khi dev)
# Ví dụ: https://your-domain.com (KHÔNG thêm /api/webhooks/heygen — tự động thêm)
# APP_URL đã được dùng để build callback_url: APP_URL + /api/webhooks/heygen
