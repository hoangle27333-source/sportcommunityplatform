FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV VOICE_ALIGNMENT_PROVIDER=whisperx
ENV WHISPERX_MODEL=small
ENV WHISPERX_COMPUTE_TYPE=int8

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg \
      git \
      libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY voice_pipeline/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY voice_pipeline ./voice_pipeline

EXPOSE 8766
CMD ["uvicorn", "voice_pipeline.app:app", "--host", "0.0.0.0", "--port", "8766"]
