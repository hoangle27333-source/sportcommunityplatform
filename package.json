{
  "name": "content-automation-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "remix:services": "docker compose up voice-pipeline ocr",
    "remix:services:detached": "docker compose up -d voice-pipeline ocr",
    "worker": "tsx watch --env-file=.env.local src/worker/index.ts",
    "worker:start": "tsx --env-file=.env.local src/worker/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "bullmq": "^5.28.1",
    "clsx": "2.1.1",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.469.0",
    "next": "^15.5.4",
    "pino": "^9.5.0",
    "playwright": "^1.62.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-filerobot-image-editor": "^5.0.0-beta.159",
    "recharts": "^2.15.0",
    "satori": "^0.12.2",
    "sharp": "^0.35.0",
    "tailwind-merge": "^2.5.5",
    "youtube-dl-exec": "^3.1.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
