{
  "name": "sport-influencer-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "worker": "tsx watch --env-file=.env.local src/worker/index.ts",
    "worker:start": "tsx --env-file=.env.local src/worker/index.ts",
    "worker:scout": "tsx --env-file=.env.local src/worker/scout.ts",
    "scout:worker": "tsx --env-file=.env.local tooling/scout/worker.ts",
    "scout:typecheck": "tsc --noEmit --project tooling/scout/tsconfig.verify.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
